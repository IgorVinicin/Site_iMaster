generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("SUBADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id         String        @id @default(cuid())
  name       String        @unique
  logoUrl    String?
  showInMenu Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  models     DeviceModel[]
}

model DeviceModel {
  id            String               @id @default(cuid())
  name          String
  imageUrl      String?
  brandId       String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  brand         Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variantPrices RepairVariantPrice[]

  @@index([brandId])
}

model RepairType {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sortOrder   Int             @default(0)
  variants    RepairVariant[]
}

model RepairVariant {
  id           String               @id @default(cuid())
  repairTypeId String
  name         String
  description  String?
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  repairType   RepairType           @relation(fields: [repairTypeId], references: [id], onDelete: Cascade)
  prices       RepairVariantPrice[]

  @@index([repairTypeId])
}

model RepairVariantPrice {
  id                  String        @id @default(cuid())
  variantId           String
  modelId             String
  price               Float
  installmentsEnabled Boolean       @default(false)
  installmentCount    Int?
  installmentValue    Float?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt
  model               DeviceModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  variant             RepairVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, modelId])
  @@index([modelId])
}


model ComparisonFAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
